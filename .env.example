# Copy to .env and fill in. NEVER commit a real .env — only this example.

# Public (inlined into the browser bundle — must not contain secrets):
# Canonical site origin used for absolute URLs, sitemap, and SEO metadata.
NEXT_PUBLIC_SITE_URL=https://radio-waa.example
# Display name used in metadata, header, and footer.
NEXT_PUBLIC_SITE_NAME=Radio Waa
# Live radio stream for the homepage player — intentionally ships empty (licensing/CDN questions, docs/live-audio-backend-research.md §8–9); unset renders the "stream not configured" state.
NEXT_PUBLIC_STREAM_URL=

# Server-only (never expose to the browser bundle):
# Postgres connection string — Termux Postgres uses trust auth on 127.0.0.1 only, so no password is needed.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/radiowaa
# Payload CMS signing secret — must be 64 random hex chars; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-64-hex-chars
# Content backend for the app — "local" serves src/data fixtures, "payload" reads Postgres through Payload CMS.
CONTENT_SOURCE=local
