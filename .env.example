# Copy to .env.local (local dev) and fill in. Never commit a real env file —
# only this example is tracked. Vercel does not read this file: set the same keys
# in Project → Settings → Environment Variables (see docs/deployment.md).

# ─── Public ───────────────────────────────────────────────────────────────────
# Inlined into the browser bundle at build time. MUST NOT contain secrets.

# Canonical origin: absolute URLs, sitemap, OpenGraph, canonical tags, and the
# origin Payload's admin posts back to. In production this is the real domain
# (https://prototype-radio.example). On Vercel, leave it unset for previews so
# the per-deployment host is used instead of pointing preview admin at production.
NEXT_PUBLIC_SITE_URL=https://radio-waa.example

# Display name used in metadata, the masthead and the footer.
NEXT_PUBLIC_SITE_NAME=Prototype Radio

# Live audio stream for the player. Intentionally empty — licensing/CDN terms are
# still open (docs/live-audio-backend-research.md §8–9), and an unset value
# renders the "stream not configured" state instead of a dead play button.
NEXT_PUBLIC_STREAM_URL=

# ─── Server only ──────────────────────────────────────────────────────────────
# Read by server components, route handlers and the build. Never exposed to the
# browser bundle.

# Postgres connection string used by Payload.
#   Local (Termux Postgres, trust auth): postgres://postgres@127.0.0.1:5432/radiowaa
#   Vercel (Neon/Supabase/Vercel Postgres): the POOLED host, e.g.
#     postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# The pooled host matters: every serverless instance keeps its own pool.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/radiowaa

# Maximum connections per instance. On Vercel the default is 3 (see
# src/payload.config.ts); raise only if the database plan allows more.
# DATABASE_POOL_MAX=3

# Payload's signing secret — exactly 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every existing admin session.
PAYLOAD_SECRET=replace-with-64-hex-chars

# Which backend serves the site's content:
#   payload — Postgres through the Payload CMS (what Vercel should use)
#   local   — the seeded fixtures in src/data (no database needed to render)
# Unset defaults to "local".
CONTENT_SOURCE=local

# Vercel Blob token, created by attaching a Blob store to the project. When set,
# Payload uploads media to Blob storage instead of the local filesystem — which
# is required on Vercel, where the filesystem is read-only.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ─── Build control ────────────────────────────────────────────────────────────

# Set to 1 to skip `payload migrate` inside the Vercel build (for teams that
# migrate out-of-band before promoting a deployment).
# PAYLOAD_SKIP_MIGRATE=1

# Force the /_next/image optimizer on or off. Defaults to on when VERCEL=1 and
# off locally, because Termux has no usable native sharp.
# NEXT_IMAGE_OPTIMIZATION=on
