{
  "name": "radio-waa",
  "version": "0.1.0",
  "private": true,
  "description": "Radio Waa \u2014 live radio, shows, podcasts and news platform (UI/UX foundation).",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "vercel-build": "node scripts/ci/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "migrate": "node scripts/ci/migrate.mjs",
    "migrate:create": "node --no-warnings --import ./scripts/ts-ext-resolve.mjs node_modules/payload/bin.js --disable-transpile migrate:create",
    "migrate:status": "node scripts/ci/migrate.mjs --status",
    "seed": "node --no-warnings --import ./scripts/ts-ext-resolve.mjs node_modules/payload/bin.js --disable-transpile run scripts/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@img/sharp-wasm32": "^0.35.5",
    "@payloadcms/db-postgres": "^3.91.0",
    "@payloadcms/next": "^3.91.0",
    "@payloadcms/storage-vercel-blob": "3.91.0",
    "clsx": "^2.1.1",
    "graphql": "^16.14.2",
    "next": "16.4.0",
    "payload": "^3.91.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^16.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
